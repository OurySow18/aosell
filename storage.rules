rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function listingDoc(listingId) {
      return firestore.get(/databases/(default)/documents/listings/$(listingId));
    }

    function canManageListingMedia(listingId) {
      return isSignedIn()
        && listingDoc(listingId).data.sellerId is string
        && firestore.get(/databases/(default)/documents/seller_profiles/$(listingDoc(listingId).data.sellerId)).data.ownerUserId == request.auth.uid;
    }

    function isActiveListing(listingId) {
      return listingDoc(listingId).data.status == 'active';
    }

    function isValidImageUpload() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function isValidVideoUpload() {
      return request.resource.size < 150 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /listing-media/{listingId}/images/{fileName} {
      allow read: if isActiveListing(listingId) || canManageListingMedia(listingId) || isAdmin();
      allow write: if canManageListingMedia(listingId) && isValidImageUpload() || isAdmin();
      allow delete: if canManageListingMedia(listingId) || isAdmin();
    }

    match /listing-media/{listingId}/video/{fileName} {
      allow read: if isActiveListing(listingId) || canManageListingMedia(listingId) || isAdmin();
      allow write: if canManageListingMedia(listingId) && isValidVideoUpload() || isAdmin();
      allow delete: if canManageListingMedia(listingId) || isAdmin();
    }

    match /listing-media/{listingId}/thumb/{fileName} {
      allow read: if isActiveListing(listingId) || canManageListingMedia(listingId) || isAdmin();
      allow write: if canManageListingMedia(listingId) && isValidImageUpload() || isAdmin();
      allow delete: if canManageListingMedia(listingId) || isAdmin();
    }

    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isSignedIn() && request.auth.uid == userId || isAdmin();
    }

    // Keyed by the uploader's own uid (not the seller profile id): a seller
    // profile can be created on-the-fly right before this upload (lazy
    // "individual" profiles), and a Storage rule reading that Firestore doc
    // immediately after it's written is not guaranteed to see it yet —
    // request.auth.uid needs no such cross-product read and is never stale.
    match /post-media/{ownerUserId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == ownerUserId && (isValidImageUpload() || isValidVideoUpload());
      allow delete: if (isSignedIn() && request.auth.uid == ownerUserId) || isAdmin();
    }

    // Written only by the onPostVideoUploaded/onPostVideoTranscoded Cloud
    // Functions (Admin SDK bypasses these rules entirely) — no client write
    // rule needed here, just public read for playback.
    match /post-media-transcoded/{ownerUserId}/{postId}/{fileName} {
      allow read: if true;
    }
  }
}
