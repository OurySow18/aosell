// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCurrency(currency) {
      return currency == 'EUR';
    }

    function isValidTimestamp(value) {
      return value is timestamp;
    }

    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function sellerDoc(sellerId) {
      return get(/databases/$(database)/documents/seller_profiles/$(sellerId));
    }

    function listingDoc(listingId) {
      return get(/databases/$(database)/documents/listings/$(listingId));
    }

    function orderDoc(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId));
    }

    function isSellerOwnerBySellerId(sellerId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/seller_profiles/$(sellerId))
        && sellerDoc(sellerId).data.ownerUserId == request.auth.uid;
    }

    function isActiveListing() {
      return resource.data.status == 'active';
    }

    function isPublicListingData() {
      return request.resource.data.status in ['draft', 'active', 'paused', 'hidden', 'archived']
        && request.resource.data.sellerId is string
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.slug is string
        && request.resource.data.type in ['product', 'meal', 'service']
        && request.resource.data.deliveryMode in ['aosell', 'seller']
        && request.resource.data.countryCode is string
        && request.resource.data.city is string
        && request.resource.data.tags is list
        && request.resource.data.categories is list
        && request.resource.data.media is list
        && request.resource.data.attributes is list
        && request.resource.data.inventory is map
        && request.resource.data.price is map
        && request.resource.data.price.amountCents is int
        && request.resource.data.price.amountCents >= 0
        && isValidCurrency(request.resource.data.price.currency)
        && request.resource.data.isFeatured is bool
        && (!('dishId' in request.resource.data) || request.resource.data.dishId is string)
        && request.resource.data.condiments is list;
    }

    function isSafeListingUpdate() {
      return request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidCuisine(value) {
      return value in [
        'senegalese', 'guinean', 'ivorian', 'malian', 'cameroonian',
        'congolese', 'nigerian', 'ghanaian', 'beninese', 'togolese'
      ];
    }

    function isValidDishData() {
      return request.resource.data.cuisine is string && isValidCuisine(request.resource.data.cuisine)
        && request.resource.data.name is string
        && request.resource.data.slug is string
        && request.resource.data.description is string
        && request.resource.data.defaultCondimentIds is list
        && request.resource.data.searchTokens is list
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);
    }

    function isValidCondimentData() {
      return request.resource.data.name is string
        && request.resource.data.normalizedName is string
        && request.resource.data.aliases is list
        && request.resource.data.searchTokens is list
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);
    }

    function isValidLinkTarget() {
      // Absent entirely = a pure share post with no commercial link.
      return !('linkTarget' in request.resource.data)
        || (
          request.resource.data.linkTarget is map
          && request.resource.data.linkTarget.type in ['listing', 'seller']
          && (
            (request.resource.data.linkTarget.type == 'seller'
              && request.resource.data.linkTarget.sellerId == request.resource.data.sellerId)
            ||
            (request.resource.data.linkTarget.type == 'listing'
              && request.resource.data.linkTarget.listingId is string
              && listingDoc(request.resource.data.linkTarget.listingId).data.sellerId == request.resource.data.sellerId)
          )
        );
    }

    function isValidPostData() {
      return request.resource.data.sellerId is string
        && request.resource.data.mediaType in ['image', 'video', 'text']
        && (request.resource.data.mediaType == 'text' || request.resource.data.mediaUrl is string)
        && request.resource.data.caption is string
        && isValidLinkTarget()
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);
    }

    // Only caption and linkTarget are editable post-publish (the media
    // itself, counters and ownership stay fixed) — everything else must come
    // back unchanged from what's already stored.
    function isSafePostUpdate() {
      return request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.mediaType == resource.data.mediaType
        && request.resource.data.get('mediaUrl', null) == resource.data.get('mediaUrl', null)
        && request.resource.data.likeCount == resource.data.likeCount
        && request.resource.data.commentCount == resource.data.commentCount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.caption is string
        && isValidLinkTarget()
        && isValidTimestamp(request.resource.data.updatedAt);
    }

    function isValidCommentData(postId) {
      return request.resource.data.postId == postId
        && request.resource.data.authorUserId == request.auth.uid
        && request.resource.data.authorDisplayNameSnapshot is string
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && isValidTimestamp(request.resource.data.createdAt);
    }

    function isValidPartnerLeadData() {
      return request.resource.data.businessName is string
        && request.resource.data.businessName.size() > 0
        && request.resource.data.businessName.size() <= 120
        && request.resource.data.businessType in ['restaurant', 'grocery', 'caterer']
        && request.resource.data.neighborhood is string
        && request.resource.data.neighborhood.size() <= 120
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() > 0
        && request.resource.data.phoneNumber.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 80
        && request.resource.data.status == 'new'
        && isValidTimestamp(request.resource.data.createdAt);
    }

    function isValidOrderStatusTransition(oldStatus, newStatus) {
      return (
        oldStatus == 'created' && newStatus in ['pending_payment', 'canceled']
      ) || (
        oldStatus == 'pending_payment' && newStatus in ['paid', 'canceled']
      ) || (
        oldStatus == 'paid' && newStatus in ['confirmed', 'canceled', 'refunded']
      ) || (
        oldStatus == 'confirmed' && newStatus in ['preparing', 'canceled']
      ) || (
        oldStatus == 'preparing' && newStatus in ['out_for_delivery', 'canceled']
      ) || (
        oldStatus == 'out_for_delivery' && newStatus in ['delivered', 'canceled']
      ) || (
        oldStatus == 'delivered' && newStatus == 'delivered'
      ) || (
        oldStatus == 'canceled' && newStatus == 'canceled'
      ) || (
        oldStatus == 'refunded' && newStatus == 'refunded'
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.role in ['buyer', 'seller', 'admin']
        && request.resource.data.isActive is bool
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /user_profiles/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.userId == userId
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.displayName is string
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.fullName is string
          && request.resource.data.phoneNumber is string
          && request.resource.data.line1 is string
          && request.resource.data.postalCode is string
          && request.resource.data.city is string
          && request.resource.data.countryCode is string
          && isValidTimestamp(request.resource.data.createdAt)
          && isValidTimestamp(request.resource.data.updatedAt);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /follows/{sellerId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId)
          && request.resource.data.sellerId == sellerId
          && isValidTimestamp(request.resource.data.createdAt);
        allow update: if false;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /seller_profiles/{sellerId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.type in ['shop', 'restaurant', 'individual']
        && request.resource.data.brandName is string
        && request.resource.data.countryCode is string
        && request.resource.data.city is string
        && request.resource.data.deliveryModes is list
        && request.resource.data.verificationStatus in ['unverified', 'pending', 'verified', 'rejected']
        && request.resource.data.tags is list
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);
      // followerCount is only ever written by the onSellerFollowWritten Cloud
      // Function (Admin SDK bypasses rules) — no client write path sets it,
      // so this just blocks it from being tampered with via a normal update.
      allow update: if (isSellerOwnerBySellerId(sellerId) || isAdmin())
        && request.resource.data.get('followerCount', 0) == resource.data.get('followerCount', 0);
      allow delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || isSellerOwnerBySellerId(resource.data.sellerId) || isAdmin();

      allow create: if isSignedIn()
        && isPublicListingData()
        && isSellerOwnerBySellerId(request.resource.data.sellerId)
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt)
        && (
          !('publishedAt' in request.resource.data) || isValidTimestamp(request.resource.data.publishedAt)
        )
        && request.resource.data.searchTokens is list
        && request.resource.data.hasVideo is bool;

      allow update: if (isSellerOwnerBySellerId(resource.data.sellerId) || isAdmin())
        && isPublicListingData()
        && isSafeListingUpdate()
        && isValidTimestamp(request.resource.data.updatedAt)
        && (
          !('publishedAt' in request.resource.data) || isValidTimestamp(request.resource.data.publishedAt)
        );

      allow delete: if isSellerOwnerBySellerId(resource.data.sellerId) || isAdmin();
    }

    match /carts/{cartId} {
      allow read: if isSignedIn()
        && (
          cartId == request.auth.uid
          || resource.data.buyerUserId == request.auth.uid
        );
      allow create: if isSignedIn()
        && request.resource.data.buyerUserId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.items is list
        && request.resource.data.subtotalAmountCents is int
        && request.resource.data.deliveryFeeAmountCents is int
        && request.resource.data.totalAmountCents is int
        && isValidCurrency(request.resource.data.currency)
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);
      allow update: if isSignedIn()
        && resource.data.buyerUserId == request.auth.uid
        && request.resource.data.buyerUserId == resource.data.buyerUserId;
      allow delete: if isSignedIn() && resource.data.buyerUserId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (
          resource.data.buyerUserId == request.auth.uid
          || isSellerOwnerBySellerId(resource.data.sellerId)
          || isAdmin()
        );

      allow create: if isSignedIn()
        && request.resource.data.buyerUserId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.items is list
        && request.resource.data.status in ['created', 'pending_payment']
        && request.resource.data.subtotalAmountCents is int
        && request.resource.data.deliveryFeeAmountCents is int
        && request.resource.data.totalAmountCents is int
        && isValidCurrency(request.resource.data.currency)
        && request.resource.data.deliveryMode in ['aosell', 'seller']
        && request.resource.data.deliveryAddress is map
        && request.resource.data.timeline is list
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);

      allow update: if isSignedIn() && (
        (
          resource.data.buyerUserId == request.auth.uid
          && request.resource.data.buyerUserId == resource.data.buyerUserId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.items == resource.data.items
          && request.resource.data.subtotalAmountCents == resource.data.subtotalAmountCents
          && request.resource.data.totalAmountCents == resource.data.totalAmountCents
          && request.resource.data.status == resource.data.status
        )
        ||
        (
          isSellerOwnerBySellerId(resource.data.sellerId)
          && request.resource.data.buyerUserId == resource.data.buyerUserId
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.items == resource.data.items
          && request.resource.data.subtotalAmountCents == resource.data.subtotalAmountCents
          && request.resource.data.totalAmountCents == resource.data.totalAmountCents
          && isValidOrderStatusTransition(resource.data.status, request.resource.data.status)
        )
        || isAdmin()
      );

      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn()
        && (
          orderDoc(resource.data.orderId).data.buyerUserId == request.auth.uid
          || isSellerOwnerBySellerId(orderDoc(resource.data.orderId).data.sellerId)
          || isAdmin()
        );
      allow create, update, delete: if isAdmin();
    }

    match /deliveries/{deliveryId} {
      allow read: if isSignedIn()
        && (
          orderDoc(resource.data.orderId).data.buyerUserId == request.auth.uid
          || isSellerOwnerBySellerId(orderDoc(resource.data.orderId).data.sellerId)
          || isAdmin()
        );
      allow create, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.buyerUserId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.rating in [1, 2, 3, 4, 5]
        && isValidTimestamp(request.resource.data.createdAt)
        && isValidTimestamp(request.resource.data.updatedAt);
      allow update: if isSignedIn() && resource.data.buyerUserId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.buyerUserId == request.auth.uid || isAdmin();
    }

    match /notifications/{userId}/items/{notificationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update, delete: if isOwner(userId) || isAdmin();
    }

    match /dishes/{dishId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.createdBySellerId is string
        && isSellerOwnerBySellerId(request.resource.data.createdBySellerId)
        && isValidDishData();
      allow update, delete: if isAdmin();
    }

    match /condiments/{condimentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.createdBySellerId is string
        && isSellerOwnerBySellerId(request.resource.data.createdBySellerId)
        && isValidCondimentData();
      allow update, delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isSellerOwnerBySellerId(request.resource.data.sellerId)
        && isValidPostData();
      allow update: if (isSellerOwnerBySellerId(resource.data.sellerId) || isAdmin())
        && isSafePostUpdate();
      allow delete: if isSellerOwnerBySellerId(resource.data.sellerId) || isAdmin();

      match /likes/{userId} {
        allow read: if true;
        allow create: if isOwner(userId)
          && request.resource.data.postId == postId
          && request.resource.data.userId == userId
          && isValidTimestamp(request.resource.data.createdAt);
        allow update: if false;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidCommentData(postId);
        allow update: if false;
        allow delete: if isSignedIn() && (resource.data.authorUserId == request.auth.uid || isAdmin());
      }
    }

    match /partner_leads/{leadId} {
      // Public submission form ("Devenir partenaire") — anyone can create a
      // lead (no auth required, matches the web form), but only admins can
      // read, change or remove one. No client-side listing of leads.
      allow read: if isAdmin();
      allow create: if isValidPartnerLeadData();
      allow update, delete: if isAdmin();
    }
  }
}
